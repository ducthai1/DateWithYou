# ─── Phase 1: Database ───────────────────────────────────────────
# MongoDB Atlas M0 connection string
MONGODB_URI=

# ─── Phase 2: Auth (Better Auth + Google OAuth) ──────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4488
# Optional: extra trusted origins (comma-separated) — e.g. a LAN IP to test on a
# phone: BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.26:4488
BETTER_AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public copy of GOOGLE_CLIENT_ID — required client-side for the Google One Tap
# prompt. Same value as GOOGLE_CLIENT_ID. Must be present BEFORE `next build`
# (NEXT_PUBLIC_* is inlined at build time).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Phase 2/7: Transactional email (Resend) ────────────────────
# Free tier: verify a sender domain (SPF/DKIM) or use the resend.dev test sender
RESEND_API_KEY=

# ─── Phase 3: Maps ───────────────────────────────────────────────
# Map tiles: MapLibre + OpenFreeMap — no token, no signup, no card.
# Directions: Stadia Maps (Valhalla motor_scooter — realistic motorbike routing,
# obeys one-way). Free tier, no credit card — sign up at https://client.stadiamaps.com
# (server-only, never shipped to client)
STADIA_API_KEY=

# Exact place coords for pasted Google Maps links (Places + Geocoding API).
# Optional — without it, link resolution falls back to approximate Stadia/OSM
# geocoding. Create at https://console.cloud.google.com (enable "Places API" +
# "Geocoding API"; $200/mo free credit covers low volume). Server-only.
GOOGLE_MAPS_API_KEY=

# Fallback geocoder with better POI data than OSM — free tier needs NO credit
# card. Create a token at https://account.mapbox.com (sign up with email only).
# Used for pasted-link resolution when GOOGLE_MAPS_API_KEY is not set. Server-only.
MAPBOX_TOKEN=

# ─── Phase 5: Cloudinary ─────────────────────────────────────────
# Public: cloud name + unsigned upload preset (browser uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Server-only: used for asset cleanup (destroy) on memory delete
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Thay bằng email Gmail thật của bạn
EMAIL_SERVER_USER=email-cua-ban@gmail.com 

# Dán 16 chữ cái App Password vừa tạo ở Bước 1 vào đây (viết liền không khoảng trắng)
EMAIL_SERVER_PASSWORD=abcdefghijklmnop

# TrackAsia — Vietnamese geocoding (Search v2) and distance matrix.
#
# Optional, like every other geocoding key: the provider chain skips any
# service whose key is absent. Worth having because it is the only provider in
# the chain that knows Vietnam's post-1/7/2025 administrative units, and the
# only one with an old-to-new address conversion endpoint.
#
# Note for later: their API defaults to returning OLD administrative units and
# flips to new on 1/7/2027. Whichever we want has to be requested explicitly
# (new_admin=true / include_old_admin=true) rather than relying on the default,
# or the meaning of every response changes by itself on that date.
TRACKASIA_API_KEY=

# Gate for /api/debug-maps. That route makes the server fetch a URL, runs the
# geocoding chain and reports the running commit; it used to answer anyone. Set
# any long random string to use it, and leave it unset to keep the route off —
# it fails closed, so a forgotten value cannot leave it open.
DEBUG_MAPS_TOKEN=
