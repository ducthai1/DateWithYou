# ─── Phase 1: Database ───────────────────────────────────────────
# MongoDB Atlas M0 connection string
MONGODB_URI=

# ─── Phase 2: Auth (Better Auth + Google OAuth) ──────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Phase 2/7: Transactional email (Resend) ────────────────────
# Free tier: verify a sender domain (SPF/DKIM) or use the resend.dev test sender
RESEND_API_KEY=

# ─── Phase 3: Maps (Mapbox) ──────────────────────────────────────
# Public token (render-only, restrict by URL) — exposed to the browser
NEXT_PUBLIC_MAPBOX_TOKEN=
# Secret token for the server-side Directions proxy — never shipped to client
MAPBOX_SECRET_TOKEN=

# ─── Phase 5: Cloudinary ─────────────────────────────────────────
# Public: cloud name + unsigned upload preset (browser uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Server-only: used for asset cleanup (destroy) on memory delete
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
